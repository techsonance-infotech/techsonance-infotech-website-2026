# ═══════════════════════════════════════════════════════════════════════════════
# TechSonance Infotech — Environment Configuration Template (.env.example)
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and populate with your actual values:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local or any secrets into version control!
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# 1. SUPABASE & POSTGRES DATABASE
# ─────────────────────────────────────────────────────────────────────────────

# Public Client Configuration (Safe for browser / client components)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_ANON_KEY=your-supabase-anon-key

# Private Server Secrets (Admin operations, seeder scripts & RLS bypass)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Drizzle ORM Database Connection
DATABASE_PASSWORD=your-database-password

# Runtime Transaction Pooler (Port 6543, prepare: false)
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Session Connection (Port 5432, used for DDL migrations)
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres"


# ─────────────────────────────────────────────────────────────────────────────
# 2. AUTHENTICATION & SECURITY SECRETS
# ─────────────────────────────────────────────────────────────────────────────

JWT_ACCESS_SECRET=your-random-jwt-access-secret-min-32-chars
BETTER_AUTH_SECRET=your-random-better-auth-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Cache On-Demand Revalidation
REVALIDATE_SECRET="your-32-char-random-revalidate-secret"


# ─────────────────────────────────────────────────────────────────────────────
# 3. AI PROVIDERS & LLM CREDENTIALS (ENV FALLBACKS)
# ─────────────────────────────────────────────────────────────────────────────
# Configure at least 1 provider for AI chatbot functionality (2+ recommended for failover).
# Note: Keys added via the Admin AI Vault (/admin/ai/credentials) take precedence.

GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
CEREBRAS_API_KEY=csk-your_cerebras_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# Cloudflare Workers AI & GitHub Models (Optional)
CF_ACCOUNT_ID=
CF_API_TOKEN=
GITHUB_MODELS_TOKEN=

# Chatbot Provider Failover Sequence & Retries
LLM_PRIORITY="groq,gemini,cerebras,openrouter,mistral,cloudflare,github"
EXHAUSTED_RETRY_HOURS=6


# ─────────────────────────────────────────────────────────────────────────────
# 4. AI VAULT & ENCRYPTION PIPELINE (AES-256-GCM)
# ─────────────────────────────────────────────────────────────────────────────

# Master 32-byte Base64-encoded Key Encryption Key (KEK) used to seal API keys at rest.
# Generate a fresh 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_KEK_V1="k4q8V4/9h5vL4P8rW3Z8N9tK2eR6vU4X7yT1wQ3mB6E="

# Next-generation KEK used for zero-downtime key rotation (leave commented until rotating)
# AI_KEK_V2=""

# Secret pepper used for HMAC-SHA256 fingerprinting to prevent duplicate key registration
AI_FP_PEPPER="dGVjaHNvbmFuY2UtYWktZnAtcGVwcGVyLTIwMjYtZGV2"


# ─────────────────────────────────────────────────────────────────────────────
# 5. AI BLOG AUTOMATION & QSTASH PIPELINE
# ─────────────────────────────────────────────────────────────────────────────

# Upstash QStash Webhook Orchestration
QSTASH_TOKEN=your-upstash-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key

# Blog Generation Governance & Caps
AI_BLOG_SITE_ID=your-default-site-uuid
AI_BLOG_APPROVER_EMAIL=info@techsonance.co.in
AI_BLOG_APPROVAL_EXPIRY_HOURS=72
AI_BLOG_DAILY_CAP=1
AI_BLOG_WEEKLY_CAP=3


# ─────────────────────────────────────────────────────────────────────────────
# 6. EMAIL & NOTIFICATIONS (SMTP / NODEMAILER / RESEND)
# ─────────────────────────────────────────────────────────────────────────────

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="CMS PORTAL - TechSonance InfoTech LLP"

# Fallback & Notification Addresses
ADMIN_EMAIL="info@techsonance.co.in"
FROM_EMAIL="TechSonance InfoTech <info@techsonance.co.in>"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="TechSonance InfoTech <info@techsonance.co.in>"

# Optional Resend API Key (alternative to SMTP)
RESEND_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# 7. CLOUDINARY MEDIA STORAGE
# ─────────────────────────────────────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name


# ─────────────────────────────────────────────────────────────────────────────
# 8. FIREBASE (CLIENT SERVICES)
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your-messaging-sender-id:web:your-app-id


# ─────────────────────────────────────────────────────────────────────────────
# 9. CONTENT & ARCHITECTURE SWITCHES
# ─────────────────────────────────────────────────────────────────────────────
# Set to 'legacy' to serve from data/*.ts, or 'cms' to serve from Supabase/Drizzle

CONTENT_SOURCE_BLOG="legacy"
CONTENT_SOURCE_CAREERS="cms"


# ─────────────────────────────────────────────────────────────────────────────
# 10. APPLICATION DOMAIN & BOT PROTECTION
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS="http://localhost:3000,https://www.techsonance.co.in,https://techsonance.co.in"
COMPANY_DOMAIN="techsonance.co.in"
ALLOW_PLACEHOLDERS="true"

# Cloudflare Turnstile Bot Protection (Optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
HEALTH_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# 11. ANALYTICS & SEARCH CONSOLE (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
