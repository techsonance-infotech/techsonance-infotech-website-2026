{
  "name": "techsonance-agency-website",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:kb": "tsx --conditions=react-server scripts/build-kb.ts",
    "check:env": "tsx --conditions=react-server scripts/check-env.ts",
    "db:check": "tsx --conditions=react-server scripts/check-db.ts",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "build": "npm run build:kb && next build",
    "start": "next start",
    "lint": "oxlint -c .oxlintrc.json",
    "lint:fix": "oxlint -c .oxlintrc.json --fix",
    "doctor": "react-doctor",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "nexus:analyze": "gitnexus analyze",
    "nexus:setup": "gitnexus setup",
    "graphify": "graphify ."
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@needle-di/core": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@upstash/qstash": "^2.12.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "dexie": "^4.4.7",
    "drizzle-orm": "^1.0.0-rc.5",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "ics": "^3.12.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "motion": "^14.9.0",
    "next": "^16.4.4",
    "nodemailer": "^10.3.1",
    "nomnoml": "^1.7.0",
    "postgres": "^4.1.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "react-hook-form": "^7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
