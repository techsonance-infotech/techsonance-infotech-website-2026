    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "gitnexus": "^1.6.12",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tailwindcss": "^1.17.1",
    "react-doctor": "^0.9.22",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
